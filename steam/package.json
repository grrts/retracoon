{
  "name": "retracoon-steam",
  "productName": "Retracoon",
  "version": "1.0.0",
  "private": true,
  "description": "Retracoon for Steam (Windows, macOS, Linux).",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux --mac --dir",
    "dist:win": "electron-builder --win --dir",
    "dist:mac": "electron-builder --mac --dir",
    "dist:linux": "electron-builder --linux --dir"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.retracoon.game",
    "productName": "Retracoon",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "game/**/*"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "Game"
    },
    "executableName": "Retracoon"
  },
  "repository": "github:grrts/retracoon",
  "author": "Retracoon"
}
