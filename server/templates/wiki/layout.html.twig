{% extends 'base.html.twig' %}

{% block title %}{% block heading %}Wiki{% endblock %} · Retracoon Wiki{% endblock %}

{% block description %}Every item, skill, foe, area and skin in Retracoon, the 8-bit raccoon roguelike.{% endblock %}

{% block stylesheets %}
<link rel="preload" href="/site/retracoon-px.woff2" as="font" type="font/woff2" crossorigin>
<style>
{% include 'wiki/_style.css.twig' %}
</style>
{% endblock %}

{% block body %}
{% set here = app.request.attributes.get('_route') %}
<header><div class="bar">
    <a class="logo" href="{{ path('home') }}">Retracoon</a>
    <nav>
        <a href="{{ path('wiki') }}"{% if here == 'wiki' %} class="on"{% endif %}>Wiki</a>
        {% for r, label in {wiki_items: 'Items', wiki_sets: 'Sets', wiki_skills: 'Skills', wiki_passives: 'Passives', wiki_foes: 'Foes', wiki_areas: 'Areas', wiki_events: 'Events', wiki_skins: 'Skins'} %}
            <a href="{{ path(r) }}"{% if here == r or here ~ 's' == r %} class="on"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    <form class="find" action="{{ path('wiki_search') }}" method="get"><input type="search" name="q" placeholder="Search" value="{{ q ?? '' }}" aria-label="Search the wiki"></form>
</div></header>
<main>
{% block content %}{% endblock %}
</main>
{% include '_footer.html.twig' with {note: "Generated from the game's content files. Numbers are what the game uses today."} %}
{% endblock %}
