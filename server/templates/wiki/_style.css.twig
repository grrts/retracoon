/* The wiki shares the website's look (site/_site.css.twig): the game's palette, the game's
   pixel font for headings and labels, the system sans for reading, square notched panels and
   hard shadows. It stays denser than the landing page because it is a reference. */
@font-face{font-family:"Retracoon Pixel";src:url(/site/retracoon-px.woff2) format("woff2");font-display:swap}
:root{--night:#0e0f1a;--bg:#1a1c2c;--panel:#29366f;--panel2:#22263d;--line:#333c57;--steel:#566c86;--text:#f4f4f4;--muted:#94b0c2;--gold:#ffcd75;--orange:#ef7d57;--cyan:#73eff7;--red:#ef7d57;--lime:#a7f070;--plum:#5d275d;
  --px:"Retracoon Pixel",ui-monospace,monospace;--sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;--notch:6px}
*{box-sizing:border-box}
body{margin:0;background:var(--night);color:var(--text);font:16px/1.55 var(--sans);-webkit-font-smoothing:antialiased}
a{color:var(--cyan);text-decoration:none}a:hover{text-decoration:underline;text-underline-offset:3px}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
header{background:rgba(14,15,26,.94);backdrop-filter:blur(8px);border-bottom:2px solid var(--line);position:sticky;top:0;z-index:2}
.bar{max-width:1120px;margin:0 auto;padding:10px 24px;display:flex;flex-wrap:wrap;gap:8px 22px;align-items:center}
.logo{font:20px/1 var(--px);color:var(--gold);text-transform:uppercase;text-shadow:2px 2px 0 var(--bg);margin-right:6px}
.logo:hover{text-decoration:none}
nav{display:flex;flex-wrap:wrap;gap:4px 16px;font:600 12px/2 var(--sans);letter-spacing:.08em;text-transform:uppercase}
nav a{color:var(--muted)}nav a:hover{color:var(--gold);text-decoration:none}nav a.on{color:var(--gold)}
form.find{margin-left:auto}
input,select,button{font:inherit;font-size:15px;background:var(--bg);color:var(--text);border:2px solid var(--steel);padding:6px 10px;border-radius:0}
input:focus{border-color:var(--gold);outline:0}
button{cursor:pointer;background:var(--panel)}
main{max-width:1120px;margin:0 auto;padding:28px 24px}
h1{color:var(--gold);font:40px/1.15 var(--px);text-transform:uppercase;margin:4px 0 10px;text-shadow:3px 3px 0 var(--plum)}
h2{color:var(--white,#f4f4f4);font:20px/1.3 var(--px);text-transform:uppercase;margin:40px 0 14px;padding-bottom:10px;border-bottom:2px dashed var(--line)}
h2 a{color:inherit}
h3{margin:0;font:700 14px/1.35 var(--sans);letter-spacing:.04em;text-transform:uppercase}
p.lead{color:var(--muted);margin:0 0 16px;font-size:17px;max-width:640px}
.spr{display:inline-block;image-rendering:pixelated;image-rendering:crisp-edges;flex:none}
.notch,.card,.hero{clip-path:polygon(0 var(--notch),var(--notch) var(--notch),var(--notch) 0,calc(100% - var(--notch)) 0,calc(100% - var(--notch)) var(--notch),100% var(--notch),100% calc(100% - var(--notch)),calc(100% - var(--notch)) calc(100% - var(--notch)),calc(100% - var(--notch)) 100%,var(--notch) 100%,var(--notch) calc(100% - var(--notch)),0 calc(100% - var(--notch)))}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.grid.small{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
.card{display:flex;gap:12px;align-items:center;background:var(--bg);box-shadow:inset 0 0 0 2px var(--line);border:0;padding:12px;color:var(--text);min-width:0;transition:transform 80ms steps(2),background 80ms steps(2)}
a.card:hover{text-decoration:none;background:#232742;box-shadow:inset 0 0 0 2px var(--gold);transform:translateY(-2px)}
.card .t{min-width:0}
.card small{display:block;color:var(--muted);font:600 11px/1.6 var(--sans);letter-spacing:.06em;text-transform:uppercase;margin-top:2px}
.card.col{flex-direction:column;text-align:center;justify-content:flex-end;padding:16px 10px}
.desc{display:block;font:13px/1.45 var(--sans);color:#d6dde6;margin-top:4px}
.pill{display:inline-block;font:600 11px/1 var(--sans);letter-spacing:.06em;padding:5px 7px;box-shadow:inset 0 0 0 2px currentColor;margin:2px 6px 2px 0;text-transform:uppercase;white-space:nowrap}
.hero{display:flex;flex-wrap:wrap;gap:28px;align-items:center;background:radial-gradient(circle at 14% 50%,rgba(192,57,142,.22),transparent 42%),var(--bg);box-shadow:inset 0 0 0 2px var(--line);padding:28px}
.hero .info{flex:1;min-width:220px}
.hero p.desc{font-size:17px;line-height:1.5}
table{border-collapse:collapse;width:100%;font-size:15px}
th,td{text-align:left;padding:10px 12px 10px 0;border-bottom:2px solid var(--line);vertical-align:top}
th{color:var(--muted);font:600 11px/1.6 var(--sans);letter-spacing:.08em;text-transform:uppercase}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px}
.filters a{padding:6px 10px;box-shadow:inset 0 0 0 2px var(--line);font:600 11px/1.4 var(--sans);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.filters a:hover{text-decoration:none;color:var(--text);box-shadow:inset 0 0 0 2px var(--steel)}
.filters a.on{box-shadow:inset 0 0 0 2px var(--gold);color:var(--gold)}
.muted{color:var(--muted)}
.risky{color:var(--red)}
.sky{height:48px;box-shadow:inset 0 0 0 2px var(--line)}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin:14px 0}
.stats div{background:var(--night);padding:8px 10px;font-size:14px;color:var(--muted)}.stats b{display:block;color:var(--gold);font:20px/1.2 var(--px)}
footer{margin-top:56px;padding:36px 0 48px;border-top:2px solid var(--line);color:var(--steel);font-size:14px}
footer .links,footer p{max-width:1120px;margin:0 auto;padding:0 24px}
footer .links{display:flex;flex-wrap:wrap;gap:8px 26px;margin-bottom:12px}
footer .links a{color:var(--muted)}
@media (max-width:640px){
  .bar,main,footer .links,footer p{padding-left:16px;padding-right:16px}
  header{position:static}
  form.find{margin-left:0;width:100%}form.find input{width:100%}
  h1{font-size:30px}
  .hero{padding:18px;gap:16px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
